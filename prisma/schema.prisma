generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String    @id @default(cuid())
  username       String    @unique
  password       String
  email          String?   // for email notifications
  role           String    @default("employee") // "super_admin" | "admin" | "employee"
  employeeCode   String?
  createdAt      DateTime  @default(now())
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  employees Employee[]
  subDepartments SubDepartment[]
  createdAt DateTime @default(now())
}

model SubDepartment {
  id           String   @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employees    Employee[]
  createdAt    DateTime @default(now())

  @@unique([name, departmentId])
}

model Designation {
  id        String   @id @default(cuid())
  name      String   @unique
  employees Employee[]
  createdAt DateTime @default(now())
}

model EmployeeManager {
  id                 String   @id @default(cuid())
  employeeId         String
  managerEmployeeId  String
  priority           Int      // 1 = primary manager, 2 = secondary, etc.
  employee           Employee @relation("EmployeeManagers", fields: [employeeId], references: [id], onDelete: Cascade)
  manager            Employee @relation("ManagerOf", fields: [managerEmployeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, managerEmployeeId])
}

model Employee {
  id              String     @id @default(cuid())
  code            String     @unique
  name            String
  birthday        DateTime?
  workAnniversary DateTime?

  employeeType    String     @default("regular") // "regular" | "wfh" | "wfm"

  departmentId    String?
  department      Department?  @relation(fields: [departmentId], references: [id])
  subDepartmentId String?
  subDepartment   SubDepartment? @relation(fields: [subDepartmentId], references: [id])
  designationId   String?
  designation     Designation? @relation(fields: [designationId], references: [id])

  managedEmployees EmployeeManager[] @relation("ManagerOf")
  managers         EmployeeManager[] @relation("EmployeeManagers")

  records         MonthRecord[]
  dailyLogs       DailyLog[]
  overrides       Override[]
  leaveBalances   LeaveBalance[]
  leaveRequests   LeaveRequest[]
  regularizations RegularizationRequest[]
  punchLogs       PunchLog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PunchLog {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  punchIn    DateTime?
  punchOut   DateTime?
  source     String    // "web" | "biometric"
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([employeeId, date])
}

model PendingChange {
  id           String   @id @default(cuid())
  requestedBy  String   // username of admin who made the change
  action       String   // "policy_update" | "toggleOverride" | "clearOverrides" | "uploadMonth" | "deleteMonth"
  payload      String   // JSON stringified payload
  status       String   @default("pending") // "pending" | "approved" | "rejected"
  reviewedBy   String?  // super_admin username who reviewed
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
}

model MonthRecord {
  id         String   @id @default(cuid())
  monthYear  String   // e.g "3_2026"
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  present    Int      @default(0)
  absent     Int      @default(0)
  halfDay    Int      @default(0)
  late       Int      @default(0)
  lateHD     Int      @default(0)
  shortShift Int      @default(0)
  ssHD       Int      @default(0)
  shortLeave Int      @default(0)
  rl         Int      @default(0)
  holi       Int      @default(0)
  
  numDays    Int      @default(31)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, monthYear])
}

model DailyLog {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  monthYear  String   // e.g. "3_2026"
  day        Int      // 1 to 31
  
  type       String   // "present", "absent", "half", "holiday", "wo", "rl"
  raw        String   @default("")
  
  inT        Int?
  outT       Int?
  
  isLate     Boolean  @default(false)
  isSS       Boolean  @default(false)
  isSL       Boolean  @default(false)
  hdReason   String?  // null | "late" | "ss" — why this day was marked half-day

  @@unique([employeeId, monthYear, day])
}

model Override {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  monthYear  String
  day        Int
  
  type       String   // "wfm", "wfm-hd", "wfh", "wos", "wos-hd"

  @@unique([employeeId, monthYear, day])
}

// Leave quota policy — one per year (global, applies to all employees)
model LeavePolicy {
  id        String @id @default(cuid())
  year      Int    @unique
  cl        Int    @default(12)
  sl        Int    @default(6)
  el        Int    @default(15)
  rl        Int    @default(2)
  sh        Int    @default(6)
  createdAt DateTime @default(now())
}

// Per-employee leave balance for a given year
model LeaveBalance {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year         Int
  clTotal      Int      @default(12)
  slTotal      Int      @default(6)
  elTotal      Int      @default(15)
  rlTotal      Int      @default(2)
  shTotal      Int      @default(6)
  clUsed       Int      @default(0)
  slUsed       Int      @default(0)
  elUsed       Int      @default(0)
  rlUsed       Int      @default(0)
  shUsed       Int      @default(0)
  clCarry      Int      @default(0)
  clAccrued    Int      @default(0)
  elAccrued    Int      @default(0)
  sandwichUsed Int      @default(0)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([employeeId, year])
}

// Leave requests submitted by employees
model LeaveRequest {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      String   // "cl" | "sl" | "el" | "rl"
  fromDate       DateTime
  toDate         DateTime
  days           Float    // 0.5 for half day, 1+ for full days
  reason         String
  status         String   @default("pending") // "pending" | "approved" | "rejected"

  // Approval stages: l2 → l1 → super → approved
  approvalStage  String   @default("pending_l2")
  currentApproverId String?

  // Sandwich leave
  sandwichCount  Int      @default(0)

  // SL prescription
  prescriptionFile String?

  // Short leave shift slot
  shiftSlot      String?

  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime @default(now())
}

// Regularization / Conflict requests — employee requests correction for missed punch or wrong marking
model RegularizationRequest {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         DateTime
  type         String   @default("missing_punch") // "missing_punch_in" | "missing_punch_out" | "wrong_mark" | "other"
  requestedIn  String?  // HH:MM
  requestedOut String?  // HH:MM
  reason       String
  // Admin/HR review
  status       String   @default("pending") // "pending" | "approved" | "rejected"
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNote   String?
  // Super admin approval
  superStatus  String   @default("pending") // "pending" | "approved" | "rejected"
  superReviewedBy String?
  superReviewedAt  DateTime?
  createdAt    DateTime @default(now())
}

// Company holiday calendar
model Holiday {
  id         String   @id @default(cuid())
  year       Int
  month      Int
  day        Int
  name       String
  type       String   @default("national") // "national" | "optional"
  isRestricted Boolean @default(false)
  status     String   @default("active") // "pending" | "active" | "rejected"
  createdBy  String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([year, month, day])
}

// Enhanced Attendance & HR policy configuration — replaces ShiftPolicy
// Admin creates/updates → status="pending" → super admin approves → status="active"
model AttendancePolicy {
  id              String   @id @default(cuid())
  name            String   @default("Default")

  // Working hours
  shiftStartH     Int      @default(10)
  shiftStartM     Int      @default(0)
  shiftEndH       Int      @default(19)
  shiftEndM       Int      @default(0)

  // Grace & late rules
  graceMinutes    Int      @default(15)  // late after shiftStart + grace
  lateStartMin    Int      @default(30)  // late window start (min from shiftStart, e.g. 10:30)
  shortLeaveStartMin Int   @default(60)  // short leave starts (e.g. 10:00 + 60 = 11:00)
  shortLeaveEndMin   Int   @default(120) // short leave ends (e.g. 12:00)
  halfDayAfterMin     Int   @default(120) // half day starts (e.g. 12:00)

  // Half day thresholds
  morningHalfDayCutoffH Int @default(14) // latest punch-in for morning half day (2:30 PM)
  morningHalfDayCutoffM Int @default(30)
  eveningHalfDayStartH   Int @default(14) // earliest punch-out for afternoon half day (2:00 PM)
  eveningHalfDayStartM   Int @default(0)

  // Evening rules
  eveningEarliestExitH   Int @default(17)  // earliest time to leave (5:00 PM)
  eveningEarliestExitM   Int @default(0)
  eveningShortLeaveWindowMin Int @default(10) // window after earliest exit for short leave

  // Deduction ratios
  minHours        Float    @default(9)   // minimum working hours
  latesPerHD      Int      @default(3)   // 3 lates = 1 HD
  ssPerHD         Int      @default(3)   // 3 short shifts = 1 HD

  // Approval workflow
  status          String   @default("pending") // "pending" | "active" | "rejected"
  createdBy       String?
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?

  effectiveFrom   DateTime @default(now())
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
}

// Super admin configuration toggles
model SuperAdminConfig {
  id                   String   @id @default(cuid())
  requireSuperApproval Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

// Audit log
model AuditLog {
  id          String   @id @default(cuid())
  performedBy String   // username
  action      String   // e.g. "override_applied", "leave_approved", "user_created", "policy_created"
  entity      String   // e.g. "employee", "leave_request", "user", "attendance_policy"
  entityId    String?  // id of the affected record
  detail      String   // human-readable description
  createdAt   DateTime @default(now())
}
