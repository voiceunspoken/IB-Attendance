generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String     @id @default(cuid())
  username        String     @unique
  password        String
  email           String?    @unique
  role            String     @default("employee") // "super_admin" | "admin" | "employee"
  disabled        Boolean    @default(false)
  code            String?    @unique
  name            String?
  birthday        DateTime?
  joiningDate     DateTime?
  workAnniversary DateTime?
  employeeType    String     @default("regular") // "regular" | "hybrid"

  departmentId    String?
  department      Department?  @relation(fields: [departmentId], references: [id])
  subDepartmentId String?
  subDepartment   SubDepartment? @relation(fields: [subDepartmentId], references: [id])
  designationId   String?
  designation     Designation? @relation(fields: [designationId], references: [id])

  deptManagerOf     Department?     @relation("DepartmentManager")
  subDeptManagerOf  SubDepartment?  @relation("SubDepartmentManager")

  managedUsers    UserManager[] @relation("ManagerOf")
  managers        UserManager[] @relation("UserManagers")

  records         MonthRecord[]
  dailyLogs       DailyLog[]
  leaveBalances   LeaveBalance[]
  leaveRequests   LeaveRequest[]
  regularizations RegularizationRequest[]
  wfhRequests     WfhRequest[]
  punchLogs       PunchLog[]
  notifications   Notification[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Department {
  id             String   @id @default(cuid())
  name           String   @unique
  managerId      String?  @unique
  manager        User?    @relation("DepartmentManager", fields: [managerId], references: [id])
  users          User[]
  subDepartments SubDepartment[]
  createdAt      DateTime @default(now())
}

model SubDepartment {
  id           String   @id @default(cuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  managerId    String?  @unique
  manager      User?      @relation("SubDepartmentManager", fields: [managerId], references: [id])
  users        User[]
  createdAt    DateTime @default(now())

  @@unique([name, departmentId])
}

model Designation {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
}

model UserManager {
  id             String   @id @default(cuid())
  userId         String
  managerUserId  String
  priority       Int      // 1 = primary manager, 2 = secondary, etc.
  user           User     @relation("UserManagers", fields: [userId], references: [id], onDelete: Cascade)
  manager        User     @relation("ManagerOf", fields: [managerUserId], references: [id], onDelete: Cascade)

  @@unique([userId, managerUserId])
}

model PunchLog {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  punchIn    DateTime?
  punchOut   DateTime?
  source     String    // "web" | "biometric"
  workLocation String? // "wfh" | "wos" | "wfm" | "wfo"
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, date])
}

model PendingChange {
  id           String   @id @default(cuid())
  requestedBy  String   // username of admin who made the change
  action       String   // "policy_update" | "uploadMonth" | "deleteMonth" | "attendance_adjustment" | "create_user" | "update_user" | "delete_user"
  payload      String   // JSON stringified payload
  status       String   @default("pending") // "pending" | "approved" | "rejected"
  reviewedBy   String?  // super_admin username who reviewed
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
}

model MonthRecord {
  id         String   @id @default(cuid())
  monthYear  String   // e.g "3_2026"
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  present    Int      @default(0)
  absent     Int      @default(0)
  halfDay    Int      @default(0)
  late       Int      @default(0)
  lateHD     Int      @default(0)
  shortShift Int      @default(0)
  ssHD       Int      @default(0)
  shortLeave Int      @default(0)
  rl         Int      @default(0)
  holi       Int      @default(0)

  numDays    Int      @default(31)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, monthYear])
}

model DailyLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  monthYear  String   // e.g. "3_2026"
  day        Int      // 1 to 31

  type       String   // "present", "absent", "half", "holiday", "wo", "rl"
  raw        String   @default("")

  inT        Int?
  outT       Int?

  isLate     Boolean  @default(false)
  isSS       Boolean  @default(false)
  isSL       Boolean  @default(false)
  isHD       Boolean  @default(false)
  hdReason   String?  // null | "late" | "ss" — why this day was marked half-day
  workLocation String? // "wfh" | "wos" | "wfm" | "wfo"

  @@unique([userId, monthYear, day])
}

// Leave quota policy — one per year (global, applies to all users)
model LeavePolicy {
  id        String @id @default(cuid())
  year      Int    @unique
  cl        Int    @default(12)
  sl        Int    @default(6)
  el        Int    @default(15)
  rl        Int    @default(2)
  sh        Int    @default(6)
  createdAt DateTime @default(now())
}

// Per-user leave balance for a given year
model LeaveBalance {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year         Int
  clTotal      Float    @default(12)
  slTotal      Float    @default(6)
  elTotal      Float    @default(15)
  rlTotal      Float    @default(2)
  shTotal      Float    @default(6)
  clUsed       Float    @default(0)
  slUsed       Float    @default(0)
  elUsed       Float    @default(0)
  rlUsed       Float    @default(0)
  shUsed       Float    @default(0)
  clCarry      Float    @default(0)
  clAccrued    Float    @default(0)
  elAccrued    Float    @default(0)
  sandwichUsed Float    @default(0)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([userId, year])
}

// Leave requests submitted by users
model LeaveRequest {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType      String   // "cl" | "sl" | "el" | "rl" | "sh"
  fromDate       DateTime
  toDate         DateTime
  days           Float    // 0.5 for half day, 1+ for full days
  unpaidDays     Float    @default(0)
  reason         String
  status         String   @default("pending") // "pending" | "approved" | "rejected"

  // Approval stages: l2 → l1 → super → approved
  approvalStage  String   @default("pending_l2")
  currentApproverId String?

  // Sandwich leave
  sandwichCount  Int      @default(0)

  // SL prescription
  prescriptionFile String?

  // Short leave shift slot
  shiftSlot      String?

  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime @default(now())
}

// WFH (Work From Home) requests — single-day WFH with manager approval
model WfhRequest {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime
  reason            String
  workType          String    @default("wfh") // "wfh" | "wos" | "wfm" | "wfo"
  status            String    @default("pending") // "pending" | "approved" | "rejected"
  approvalStage     String    @default("pending_l2")
  currentApproverId String?
  reviewedBy        String?
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime  @default(now())
}

// Regularization / Conflict requests — user requests correction for missed punch or wrong marking
model RegularizationRequest {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime
  type         String   @default("missing_punch") // "missing_punch_in" | "missing_punch_out" | "wrong_mark" | "other"
  requestedIn  String?  // HH:MM
  requestedOut String?  // HH:MM
  reason       String
  // Admin/HR review
  status       String   @default("pending") // "pending" | "approved" | "rejected"
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNote   String?
  // Super admin approval
  superStatus  String   @default("pending") // "pending" | "approved" | "rejected"
  superReviewedBy String?
  superReviewedAt  DateTime?
  createdAt    DateTime @default(now())
}

// Company holiday calendar
model Holiday {
  id         String   @id @default(cuid())
  year       Int
  month      Int
  day        Int
  name       String
  type       String   @default("national") // "national" | "optional"
  isRestricted Boolean @default(false)
  status     String   @default("active") // "pending" | "active" | "rejected"
  createdBy  String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([year, month, day])
}

// Enhanced Attendance & HR policy configuration — replaces ShiftPolicy
// Admin creates/updates → status="pending" → super admin approves → status="active"
model AttendancePolicy {
  id              String   @id @default(cuid())
  name            String   @default("Default")

  // Working hours
  shiftStartH     Int      @default(10)
  shiftStartM     Int      @default(0)
  shiftEndH       Int      @default(19)
  shiftEndM       Int      @default(0)

  // Grace & late rules
  graceMinutes    Int      @default(15)
  lateStartMin    Int      @default(30)
  shortLeaveStartMin Int   @default(60)
  shortLeaveEndMin   Int   @default(120)
  halfDayAfterMin     Int   @default(120)

  // Half day thresholds
  morningHalfDayCutoffH Int @default(14)
  morningHalfDayCutoffM Int @default(30)
  eveningHalfDayStartH   Int @default(14)
  eveningHalfDayStartM   Int @default(0)

  // Evening rules
  eveningEarliestExitH   Int @default(17)
  eveningEarliestExitM   Int @default(0)
  eveningShortLeaveWindowMin Int @default(10)

  // Deduction ratios
  minHours        Float    @default(9)
  latesPerHD      Int      @default(3)
  ssPerHD         Int      @default(3)

  // Approval workflow
  status          String   @default("pending") // "pending" | "active" | "rejected"
  createdBy       String?
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?

  effectiveFrom   DateTime @default(now())
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
}

// Per-action toggle: should admin actions require super admin approval?
model AdminActionConfig {
  id                String   @id @default(cuid())
  actionType        String   @unique
  requiresApproval  Boolean  @default(true)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

// Super admin configuration toggles
model SuperAdminConfig {
  id                   String   @id @default(cuid())
  requireSuperApproval Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

// Audit log
model AuditLog {
  id          String   @id @default(cuid())
  performedBy String   // username
  action      String   // e.g. "override_applied", "leave_approved", "user_created", "policy_created"
  entity      String   // e.g. "employee", "leave_request", "user", "attendance_policy"
  entityId    String?  // id of the affected record
  detail      String   // human-readable description
  createdAt   DateTime @default(now())
}

// In-app notifications
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // leave_submitted, leave_approved, leave_rejected, regularization_submitted, regularization_approved, regularization_rejected, adjustment_submitted, adjustment_approved, adjustment_rejected, name_change_approved, name_change_rejected
  title     String
  message   String
  payload   String?  // JSON string with request details
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}
